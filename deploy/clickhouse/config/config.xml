<clickhouse>
    <listen_host>0.0.0.0</listen_host>

    <macros>
        <cluster>superoptic_cluster</cluster>
        <shard>01</shard>
        <replica>replica_01</replica>
    </macros>

    <zookeeper>
        <node>
            <host>clickhouse-keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <storage_configuration>
        <disks>
            <default>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes>
            </default>
            <archive_disk>
                <path>/var/lib/superoptic-clickhouse-archive/</path>
            </archive_disk>
        </disks>
        <policies>
            <hot_then_archive>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <archive>
                        <disk>archive_disk</disk>
                    </archive>
                </volumes>
            </hot_then_archive>
        </policies>
    </storage_configuration>
</clickhouse>
