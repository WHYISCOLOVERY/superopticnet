# Defense-in-depth (2026-09-24 security audit): the project root .htaccess already
# blocks the whole data/ directory with `RewriteRule ^data(/|$) - [F,L]`, but that
# guard only fires when mod_rewrite is enabled. This directory holds server-side-only
# state — rate-limits.json, security-events.jsonl, system-settings.json and
# cache/billing_*.json (which can contain customer names, debts and recent payments).
# None of it is ever fetched over HTTP (the app reads these files from disk via PHP),
# so denying direct web access here is safe and closes the mod_rewrite-off edge case.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
