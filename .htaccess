Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Preserve Bearer tokens for PHP/FastCGI mobile and service endpoints.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(?:data|tmp|tools|deploy|db|docs|output|config|graphify-out|whatsapp-bridge|\.git|\.ai-collaboration|\.claude|\.tools)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "(^\.|config\.local\.php$|config\.php\.(bak|old|orig|swp)$|\.jsonl$|\.sql$|\.env(?:\..*)?$|\.ps1$|\.sh$|\.bat$|\.cmd$|\.md$|composer\.(json|lock)$|package(-lock)?\.json$|\.(bak|old|orig|swp)$)">
    Require all denied
</FilesMatch>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|config\.local\.php$|config\.php\.(bak|old|orig|swp)$|\.jsonl$|\.sql$|\.env(?:\..*)?$|\.ps1$|\.sh$|\.bat$|\.cmd$|\.md$|composer\.(json|lock)$|package(-lock)?\.json$|\.(bak|old|orig|swp)$)">
        Deny from all
    </FilesMatch>
</IfModule>
