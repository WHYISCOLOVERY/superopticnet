# Copy variable names into the operating system or service environment.
# Never put real values in this file or commit a populated .env file.

# Demo fixtures are accepted only in development/dev/local/test and remain off by default.
APP_DEMO_FIXTURES_ENABLED=0

# Safety interlock. External SMS, Telegram and WhatsApp requests remain paused until this is explicitly enabled.
COMMUNICATION_EXTERNAL_SEND_ENABLED=0

# AI provider: "local" (on-premise, no cloud) or "deepseek" (external).
AI_MODEL_PROVIDER=local
# Local on-prem LLM (Ollama or any OpenAI-compatible server). Loopback only.
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_API=ollama
# External provider (used only when AI_MODEL_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

SMS_PROVIDER_PUBLIC_KEY=
SMS_PROVIDER_PRIVATE_KEY=
SMS_LIVE_TEST_SUBSCRIBER_CODE=2320025

TELEGRAM_TOKEN=
TELEGRAM_NETWORK_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_FINANCE_BOT_TOKEN=
TELEGRAM_WAREHOUSE_BOT_TOKEN=
TELEGRAM_BACKUP_BOT_TOKEN=
TELEGRAM_DIAGNOSTICS_BOT_TOKEN=
TELEGRAM_MODEM_SEARCH_BOT_TOKEN=
WHATSAPP_PROVIDER_TOKEN=
API_SECRET_KEY=
PAIRING_WORKER_TOKEN=

DB_PASS=
RADIUS_SHARED_SECRET=
RADIUS_DB_PASS=
RADIUS_SQL_PASSWORD=
RADIUS_ROUTER_SECRET=
RADIUS_SSH_PASSWORD=
RADIUS_TEST_PASSWORD=
MGS_SNMP_READ_COMMUNITY=
MGS_SNMP_WRITE_COMMUNITY=
SNMP_COMMUNITY=

IMPORT_API_TOKEN=
PROVIDER_API_TOKEN=
PROVIDER_API_HMAC_SECRET=
EMANAT_PROVIDER_API_TOKEN=
EMANAT_PROVIDER_HMAC_SECRET=
UNITEDPAYMENT_PROVIDER_API_TOKEN=
UNITEDPAYMENT_PROVIDER_HMAC_SECRET=
COPILOT_API_TOKEN=
RECAPTCHA_SECRET=
